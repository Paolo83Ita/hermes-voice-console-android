    <string name="qr_title">Scan pairing QR</string>
    <string name="qr_intro">Point the camera at the Tower\'s hermes-pair QR code. Frames are decoded on-device and never stored. The payload is checked by the strict versioned parser before anything is offered for pairing.</string>
    <string name="qr_permission_card">Camera permission</string>
    <string name="qr_permission_note">The camera is used only while this screen is visible, to read a pairing QR. No frame is saved or sent anywhere. You can also pair without QR by entering the pairing code manually in Tower Studio.</string>
    <string name="qr_permission_refused">Camera permission was refused — QR scanning is unavailable. Manual pairing code entry in Tower Studio still works.</string>
    <string name="qr_grant_button">Grant camera permission</string>
    <string name="qr_unavailable_card">Camera unavailable</string>
    <string name="qr_unavailable_note">Typed failure: %1$s. The rest of the app is unaffected; manual pairing code entry in Tower Studio still works.</string>
    <string name="qr_result_card">Scan result</string>
    <string name="qr_looking_fmt">Looking for a hermes-pair QR… (%1$d frames analyzed)</string>
    <string name="qr_refused_fmt">REFUSED %1$s — %2$s</string>
    <string name="qr_refused_note">The strict parser refused this code; nothing was paired. Point at a fresh Tower QR or go back.</string>
    <string name="qr_scan_again">Scan again</string>
    <string name="qr_accepted">Payload accepted by the strict parser:</string>
    <string name="qr_mock_note">Endpoint and challenge are held but never displayed; pairing runs through the DETERMINISTIC MOCK executor — the result below is SIMULATED. Real pairing is Tower Graph 1.7 authority.</string>
    <string name="qr_pair_button">Pair with this Tower (SIMULATED)</string>
    <string name="qr_pairing_progress">SIMULATED pairing in progress…</string>
    <string name="qr_result_ok_fmt">SIMULATED result — session %1$s, match phrase %2$s. No real Tower was contacted (Tower Graph 1.7 pending).</string>
    <string name="qr_result_fail_fmt">SIMULATED pairing refused: %1$s — %2$s</string>
    <string name="qr_back">Back to Tower Studio</string>
    <string name="qr_replay_note">Note: rescanning the same QR after a successful parse is honestly refused as REPLAYED_NONCE — pairing nonces are single-use by contract.</string>
    <string name="voice_title">Voice &amp; Audio</string>
    <string name="voice_wake_card">Wake word</string>
    <string name="voice_provider_fmt">PROVIDER: %1$s CANDIDATES</string>
    <string name="voice_engine_fmt">ENGINE: %1$s</string>
    <string name="voice_wake_note">Configuration placeholder. Candidates (openWakeWord, Porcupine) are QUALIFY_ON_DEVICE — nothing is active until physical tests pass (VOICE_PIPELINE_OPTIONS §2).</string>
    <string name="voice_vad_card">Voice activity detection</string>
    <string name="voice_vad_note">Silero VAD (primary candidate) and WebRTC VAD (prototype) behind one seam; qualification criteria fixed in VOICE_PIPELINE_OPTIONS §3.</string>
    <string name="voice_stt_card">Speech-to-text</string>
    <string name="voice_v01_path">V0.1 PATH: TEXT INJECTION</string>
    <string name="voice_stt_note">whisper.cpp is the primary QUALIFY_ON_DEVICE candidate; the Android system recognizer is a prototype fallback that must prove fully on-device behavior before LOCAL-mode use.</string>
    <string name="voice_tts_card">Text-to-speech</string>
    <string name="voice_tts_active">SYSTEM TTS — ACTIVE (REAL AUDIO)</string>
    <string name="voice_tts_unavailable">SYSTEM TTS — UNAVAILABLE (text-only)</string>
    <string name="voice_speed_fmt">Speaking speed: %1$s×</string>
    <string name="voice_tts_note">Voice selection and higher-quality local voices (Piper candidate, Kokoro deferred) follow the physical qualification sessions; the target voice is calm, authoritative, Italian-first.</string>
    <string name="voice_interruption_card">Interruption &amp; captions</string>
    <string name="voice_barge_in">Barge-in: new input interrupts playback</string>
    <string name="voice_captions">Captions</string>
    <string name="voice_capture_note">Stop-speaking and privacy mute are always available on the console; speech is never captured into persistent logs (SEC §4).</string>
    <string name="li_title">Local Intelligence</string>
    <string name="li_engine_card">Local conversation engine</string>
    <string name="li_state_fmt">STATE: %1$s</string>
    <string name="li_runtime_none">RUNTIME: NONE INSTALLED</string>
    <string name="li_mock_note">V0.1 serves the seam with a deterministic mock. No model files exist on this device; no model is downloaded during the foundation phase (mission rule; LOCAL_MODEL_CANDIDATE_PLAN §2).</string>
    <string name="li_candidates_card">Candidates (not endorsements)</string>
    <string name="li_meta_fmt">%1$s — %2$s</string>
    <string name="li_note_fastest">fastest; weakest reasoning</string>
    <string name="li_note_italian">good Italian</string>
    <string name="li_note_tradeoff">best trade-off candidate</string>
    <string name="li_note_ceiling">quality ceiling; RAM risk</string>
    <string name="li_qualify_badge">QUALIFY_ON_DEVICE (V0.6)</string>
    <string name="li_routing_card">Routing policy (HYBRID)</string>
    <string name="li_routing_note">Simple, qualified queries (greetings, help, device status, time) resolve locally. Complex, operational, uncertain or consequential requests route to Hermes Tower. Low STT confidence (&lt; 0.55) escalates to the Tower in HYBRID mode.</string>
    <string name="li_scope_note">The optional local model may only: converse, detect intent, clean commands, correct STT, assist routing, summarize a turn before forwarding, explain status, and answer offline. It never executes consequential actions (FR-19).</string>
    <string name="li_limits_card">Resource limits (targets)</string>
    <string name="li_limits_note">With model resident: ≤ 1.6 GB RSS total; unload on idle timer; one resident model at a time. Cold load ≤ 4 s; warm first token ≤ 1.5 s; ≥ 8 tok/s — all pass-guidelines pending measurement (NFR-09).</string>
    <string name="li_controls_card">Load / unload controls</string>
    <string name="li_load_badge">LOAD — ENABLES AT V0.6</string>
